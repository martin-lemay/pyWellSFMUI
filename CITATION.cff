license: Apache-2.0
repository-code: "https://github.com/martin-lemay/pyWellSFMUI"
url: "https://pywellsfmui.readthedocs.io/en/latest/"
keywords:
  - stratigraphic forward modeling
  - sedimentology
  - stratigraphy
  - well
